data "terraform_remote_state" "baseline" {
  backend = "local"
  config = {
    path = "../../baseline_azure/terraform.tfstate"
  }
}

# Public IP so the attacker can SSH from outside
resource "azurerm_public_ip" "victim" {
  name                = "pathtriage-z1-pip"
  resource_group_name = data.terraform_remote_state.baseline.outputs.rg_name
  location            = data.terraform_remote_state.baseline.outputs.location
  allocation_method   = "Static"
  sku                 = "Standard"
}

# NSG — allow SSH from anywhere (deliberately permissive for lab)
resource "azurerm_network_security_group" "victim" {
  name                = "pathtriage-z1-nsg"
  resource_group_name = data.terraform_remote_state.baseline.outputs.rg_name
  location            = data.terraform_remote_state.baseline.outputs.location

  security_rule {
    name                       = "SSH"
    priority                   = 1000
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "22"
    source_address_prefix      = "*"
    destination_address_prefix = "*"
  }
}

resource "azurerm_network_interface" "victim" {
  name                = "pathtriage-z1-nic"
  resource_group_name = data.terraform_remote_state.baseline.outputs.rg_name
  location            = data.terraform_remote_state.baseline.outputs.location

  ip_configuration {
    name                          = "internal"
    subnet_id                     = data.terraform_remote_state.baseline.outputs.subnet_id
    private_ip_address_allocation = "Dynamic"
    public_ip_address_id          = azurerm_public_ip.victim.id
  }
}

resource "azurerm_network_interface_security_group_association" "victim" {
  network_interface_id      = azurerm_network_interface.victim.id
  network_security_group_id = azurerm_network_security_group.victim.id
}

# The vulnerable VM — overprivileged System-Assigned Managed Identity
resource "azurerm_linux_virtual_machine" "victim" {
  name                            = "pathtriage-z1-vm"
  resource_group_name             = data.terraform_remote_state.baseline.outputs.rg_name
  location                        = data.terraform_remote_state.baseline.outputs.location
  size                            = "Standard_B2s"
  admin_username                  = "azureuser"
  network_interface_ids           = [azurerm_network_interface.victim.id]
  disable_password_authentication = true

  # This is the misconfiguration that makes Z1 exploitable
  identity {
    type = "SystemAssigned"
  }

  admin_ssh_key {
    username   = "azureuser"
    public_key = file("~/.ssh/id_rsa.pub")
  }

  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "Standard_LRS"
  }

  source_image_reference {
    publisher = "Canonical"
    offer     = "0001-com-ubuntu-server-jammy"
    sku       = "22_04-lts-gen2"
    version   = "latest"
  }
}

# The "vulnerability" — VM's MI given Contributor at subscription scope
resource "azurerm_role_assignment" "vm_overprivileged" {
  scope                = "/subscriptions/${data.terraform_remote_state.baseline.outputs.subscription_id}"
  role_definition_name = "Contributor"
  principal_id         = azurerm_linux_virtual_machine.victim.identity[0].principal_id
}
